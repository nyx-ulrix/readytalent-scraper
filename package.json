{
  "name": "autoresume",
  "private": true,
  "version": "1.2.10",
  "description": "AutoResume - ReadyTalent job scraper with AI resume and cover letter (A4)",
  "author": "Malcolm Liew",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis",
    "test": "node test/boards.test.cjs && node test/ground.test.ts && node test/markdown.test.ts && node test/pay.test.ts && node test/linkify.test.ts && node test/geo.test.ts && node test/merge.test.ts && node electron/scrape.test.cjs",
    "dist:win": "vite build && electron-builder --win nsis --publish never",
    "dist:mac": "vite build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "build": {
    "appId": "app.autoresume",
    "productName": "AutoResume",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png",
      "artifactName": "AutoResume-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "AutoResume"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "AutoResume-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "AutoResume ${version}"
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyx-ulrix/readytalent-scraper.git"
  }
}