{
  "name": "autoresume",
  "private": true,
  "version": "1.0.0",
  "description": "AutoResume - ReadyTalent job scraper with AI resume and cover letter (A4)",
  "author": "Malcolm Liew",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "app.autoresume",
    "productName": "AutoResume",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "public/icon-512.png", "artifactName": "AutoResume-Setup-${version}.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "shortcutName": "AutoResume" }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
